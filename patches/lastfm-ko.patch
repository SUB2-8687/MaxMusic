@@ -0,0 +1,6 @@
+#import <Foundation/Foundation.h>
+
+static inline NSString *LFMText(NSString *english, NSString *korean) {
+    NSString *language = [NSBundle mainBundle].preferredLocalizations.firstObject ?: [NSLocale preferredLanguages].firstObject;
+    return [language hasPrefix:@"ko"] ? korean : english;
+}
